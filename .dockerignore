# Used only by frontend/Dockerfile, the one image built from the repository
# root (the backend's context is backend/, with its own .dockerignore). It is an
# allowlist: everything is left out except the frontend and the shared number
# cases its tests import, so the context stays small and new top-level files
# never reach it.
*
!frontend/
!testdata/numbers.json

# Built or installed on the host; the image installs and builds its own.
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/Dockerfile

# Settings that change from machine to machine. Copy this file to .env and
# edit it; .env is git-ignored. docker compose reads it from this folder, and
# so does the frontend's dev server (vite.config.ts). A variable set in the
# shell wins. Nothing here is secret.

# The port the app is published on, on this machine only (127.0.0.1).
WEB_PORT=8080

# Where `npm run dev` forwards /api: the Go service started with `go run`.
API_PROXY_TARGET=http://127.0.0.1:8081

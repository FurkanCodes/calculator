# Copy to .env, which git ignores. Docker Compose and the Vite dev server both
# read it, and a variable set in the shell wins. Nothing here is secret.

# Published on 127.0.0.1 only.
WEB_PORT=8080

# Where `npm run dev` forwards /api, the Go service from `go run`.
API_PROXY_TARGET=http://127.0.0.1:8081

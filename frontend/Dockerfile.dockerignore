# BuildKit applies this to frontend/Dockerfile only. Paths are from the repo
# root. Everything is left out unless listed, so new top-level files stay out.
*
!frontend/
!testdata/numbers.json

# The image installs and builds its own.
frontend/node_modules/
frontend/dist/
frontend/coverage/
# May hold secrets.
frontend/.env*
# Read by BuildKit itself, never copied.
frontend/Dockerfile
frontend/Dockerfile.dockerignore
